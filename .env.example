# =============================================================================
#  Jarvis AI Platform — Environment Variables Template
# =============================================================================
#
#  HOW TO USE
#  ----------
#  1. Copy this file:   cp .env.example .env      (Linux/macOS)
#                       copy .env.example .env    (Windows)
#  2. Fill in your actual values in .env
#  3. NEVER commit .env to version control
#
#  Every variable below has a default — only GROQ_API_KEY is required.
# =============================================================================


# =============================================================================
# 🔑  REQUIRED — API CREDENTIALS
# =============================================================================

# Your Groq Cloud API key.
# Get a free key at: https://console.groq.com/ → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here


# =============================================================================
# 🧠  LLM — Language Model (Groq Cloud)
# =============================================================================

# Chat/completion model served by Groq.
# Fast & free tier options:
#   llama-3.1-8b-instant        ← default (fastest, great for voice)
#   llama-3.3-70b-versatile     ← smarter, slower
#   llama-3.1-70b-versatile     ← alternative 70B
#   mixtral-8x7b-32768          ← good for long context
#   gemma2-9b-it                ← Google Gemma 2
LLM_MODEL=llama-3.1-8b-instant

# Sampling temperature — controls creativity vs determinism.
# Range: 0.0 (deterministic) → 2.0 (very creative)
# Recommended for voice assistant: 0.5 – 0.8
LLM_TEMPERATURE=0.7

# Maximum number of tokens the model can generate per response.
# Higher = longer answers, more latency.
# Range: 64 – 8192 (model-dependent)
LLM_MAX_TOKENS=512

# Number of previous chat messages kept in context (rolling window).
# Each exchange = 2 messages (user + assistant).
# Higher = better memory, more tokens consumed per request.
LLM_HISTORY_LIMIT=20

# System prompt injected at the start of every conversation.
# Defines Jarvis's personality and behaviour.
# Keep it concise — it counts against your token budget every call.
LLM_SYSTEM_PROMPT=You are Jarvis, a highly intelligent, precise, and helpful AI assistant. Respond concisely and accurately. Avoid unnecessary filler phrases. Get straight to the point.


# =============================================================================
# 🎤  STT — Speech-to-Text (Groq Whisper)
# =============================================================================

# Whisper model served by Groq for audio transcription.
# Options:
#   whisper-large-v3            ← default (most accurate)
#   whisper-large-v3-turbo      ← faster, slightly less accurate
#   distil-whisper-large-v3-en  ← English-only, fastest
STT_MODEL=whisper-large-v3

# Language hint passed to Whisper.
# Use an ISO 639-1 code (e.g. en, tr, fr, de, es, ja).
# Set to "auto" to let Whisper detect the language automatically.
STT_LANGUAGE=en


# =============================================================================
# 🔊  TTS — Text-to-Speech (Microsoft Edge TTS)
# =============================================================================

# Neural voice used for speech synthesis.
# Browse all available voices: https://github.com/rany2/edge-tts#usage
#   Run: edge-tts --list-voices
#
# Popular English voices:
#   en-US-AriaNeural            ← default (friendly, female)
#   en-US-GuyNeural             ← male, American English
#   en-US-JennyNeural           ← female, conversational
#   en-GB-SoniaNeural           ← female, British English
#   en-GB-RyanNeural            ← male, British English
#   en-AU-NatashaNeural         ← female, Australian English
TTS_VOICE=en-US-AriaNeural

# Speaking rate adjustment relative to the default speed.
# Format: +N%  or  -N%   (e.g. +20%, -10%)
# Range: -100% to +100%
TTS_RATE=+0%

# Pitch adjustment relative to the default pitch.
# Format: +NHz  or  -NHz  (e.g. +5Hz, -10Hz)
TTS_PITCH=+0Hz

# Volume adjustment relative to the default volume.
# Format: +N%  or  -N%
TTS_VOLUME=+0%


# =============================================================================
# 💬  INTERACTION MODE
# =============================================================================

# Choose how you want to interact with Jarvis:
#   voice  ← default (use microphone, push-to-talk with space)
#   chat   ← text-only (type your messages)
INTERACTION_MODE=voice


# =============================================================================
# 🖥️  UI — Layout / Encoding
# =============================================================================
#
# Some Windows console hosts render Unicode box-drawing / block glyphs as random
# symbols. If your header/rules look "corrupted", switch to compact + ASCII.
#
# full    = show JARVIS header (ASCII art) at startup/toggles
# compact = status bar only
JARVIS_UI_LAYOUT=full
#
# Unicode UI glyphs (●, », ─, █). Set to 1 only if your terminal renders them cleanly.
JARVIS_UNICODE_UI=0


# =============================================================================
# 🎙️  AUDIO — Recording (Microphone)
# =============================================================================

# Microphone sample rate in Hz.
# 44100 is CD quality and universally supported.
# Whisper also works well at 16000 (halves file size).
# Options: 16000 | 22050 | 44100 | 48000
SAMPLE_RATE=44100

# Key used to trigger Push-To-Talk. Must be a valid keyboard key string.
# Examples: space, alt, ctrl, shift
PTT_KEY=space

# Input audio file path (where microphone recording is saved).
# Relative to the project root, or use an absolute path.
# This file is overwritten on every recording cycle.
INPUT_AUDIO_PATH=audio/input.wav

# Output audio file path (where TTS synthesis result is saved).
# This file is overwritten on every TTS cycle.
OUTPUT_AUDIO_PATH=audio/response.mp3


# =============================================================================
# 🔁  RESILIENCE — Retry Logic
# =============================================================================

# Maximum number of retry attempts for failed API calls (LLM + STT).
# Set to 1 to disable retries.
# Range: 1 – 10
MAX_RETRIES=3

# Base delay in seconds between retry attempts.
# Actual delay = RETRY_DELAY × attempt_number  (linear backoff).
# Example with RETRY_DELAY=1.0: attempt 1 waits 1s, attempt 2 waits 2s, etc.
# Range: 0.1 – 10.0
RETRY_DELAY=1.0


# =============================================================================
# 📋  LOGGING
# =============================================================================

# Logging verbosity level.
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file name inside the logs/ directory.
# Set to "none" or leave blank to disable file logging (console only).
LOG_FILE=jarvis.log
